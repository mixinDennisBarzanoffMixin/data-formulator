FROM docker.io/oven/bun:1.3.10 AS build
WORKDIR /src/packages/data-formulator
COPY packages/data-formulator/package.json packages/data-formulator/bun.lock ./
RUN bun install --frozen-lockfile
COPY packages/data-formulator .
RUN bun run build:veritly

FROM docker.io/nginx:1.29-alpine
COPY --from=build /src/packages/data-formulator/dist-veritly /usr/share/nginx/html
COPY packages/data-formulator/deploy/veritly.nginx.conf /etc/nginx/conf.d/default.conf
