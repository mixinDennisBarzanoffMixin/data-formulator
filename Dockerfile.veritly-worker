FROM docker.io/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY packages/data-formulator/deploy/worker-requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/data-formulator/py-src/data_formulator/veritly_worker.py ./data_formulator/veritly_worker.py
USER 65532:65532
EXPOSE 8080
CMD ["python", "-m", "data_formulator.veritly_worker"]
